// Spandex DMA Controller
//
// Minimal DMA controller for the Spandex + GPU VIPER_TCC/TU project.
// DMA requests are not on the main GPU TCP -> TCC -> TU path; they are used
// by the GPU runtime/command/DMA devices and go directly to the Spandex LLC
// directory using the same Spandex message format.
//
// Project simplification:
// - DMA read  : Sequencer LD -> Spandex ReqV
// - DMA write : Sequencer ST -> Spandex ReqWT with DataBlk + writeMask
// - Do not use ReqWTD, because the simplified Spandex LLC/TU bring-up uses
//   ReqWT as the write-through-with-data request type.
// - No atomic/RMW support here.
//
// Network usage:
// - vnet 1: DMA -> Spandex LLC/Directory requests
// - vnet 3: Spandex LLC/Directory -> DMA responses

machine(MachineType:DMA, "Spandex DMA Controller")
    : DMASequencer * dma_sequencer;
      Cycles request_latency := 6;

      MessageBuffer * responseFromDir, network="From", virtual_network="3",
            vnet_type="response";
      MessageBuffer * requestToDir, network="To", virtual_network="1",
            vnet_type="request";
      MessageBuffer * mandatoryQueue;
{
  state_declaration(State, desc="DMA states", default="DMA_State_READY") {
    READY,    AccessPermission:Invalid, desc="Ready to accept a new request";
    BUSY_RD,  AccessPermission:Busy,    desc="Busy: processing read";
    BUSY_WR,  AccessPermission:Busy,    desc="Busy: processing write";
  }

  enumeration(Event, desc="DMA events") {
    ReadRequest,  desc="A new read request";
    WriteRequest, desc="A new write request";
    Data,         desc="Data from directory";
    Ack,          desc="Write ack from directory";
  }

  structure(TBE, desc="...") {
    State TBEState,    desc="Transient state";
    DataBlock DataBlk, desc="Data";
  }

  structure(TBETable, external = "yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
  }

  void set_tbe(TBE b);
  void unset_tbe();
  void wakeUpAllBuffers();

  TBETable TBEs, template="<DMA_TBE>", constructor="m_number_of_TBEs";

  Tick clockEdge();
  MachineID mapAddressToMachine(Addr addr, MachineType mtype);

  State getState(TBE tbe, Addr addr) {
    if (is_valid(tbe)) {
      return tbe.TBEState;
    } else {
      return State:READY;
    }
  }

  void setState(TBE tbe, Addr addr, State state) {
    if (is_valid(tbe)) {
      tbe.TBEState := state;
    }
  }

  AccessPermission getAccessPermission(Addr addr) {
    return AccessPermission:NotPresent;
  }

  void setAccessPermission(Addr addr, State state) {
  }

  void functionalRead(Addr addr, Packet *pkt) {
    error("DMA does not support functional read.");
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    error("DMA does not support functional write.");
  }

  out_port(requestToDir_out, SpandexRequestMsg, requestToDir, desc="DMA requests to Spandex LLC/Directory");

  in_port(dmaRequestQueue_in, SequencerMsg, mandatoryQueue, desc="Incoming DMA sequencer requests") {
    if (dmaRequestQueue_in.isReady(clockEdge())) {
      peek(dmaRequestQueue_in, SequencerMsg) {
        if (in_msg.Type == SequencerRequestType:LD) {
          trigger(Event:ReadRequest, in_msg.LineAddress,
                  TBEs[in_msg.LineAddress]);
        } else if (in_msg.Type == SequencerRequestType:ST) {
          trigger(Event:WriteRequest, in_msg.LineAddress,
                  TBEs[in_msg.LineAddress]);
        } else {
          error("Invalid/unsupported DMA request type: only LD/ST are supported in this Spandex DMA controller");
        }
      }
    }
  }

  in_port(dmaResponseQueue_in, SpandexResponseMsg, responseFromDir, desc="Responses from Spandex LLC/Directory") {
    if (dmaResponseQueue_in.isReady(clockEdge())) {
      peek(dmaResponseQueue_in, SpandexResponseMsg) {
        if (in_msg.Type == SpandexResponseType:Data) {
          trigger(Event:Data, in_msg.addr, TBEs[in_msg.addr]);
        } else if (in_msg.Type == SpandexResponseType:Ack) {
          trigger(Event:Ack, in_msg.addr, TBEs[in_msg.addr]);
        } else {
          error("Invalid/unsupported DMA response type: expected Data or Ack");
        }
      }
    }
  }

  action(s_sendReadRequest, "s", desc="Send a ReqV to directory") {
    peek(dmaRequestQueue_in, SequencerMsg) {
      enqueue(requestToDir_out, SpandexRequestMsg, request_latency) {
        out_msg.addr := in_msg.LineAddress;
        out_msg.Type := SpandexRequestType:ReqV;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(mapAddressToMachine(address,
                                                   MachineType:Directory));
        out_msg.MessageSize := MessageSizeType:Control;
      }
    }
  }

  action(sw_sendWriteRequest, "\s", desc="Send a ReqWT with data to directory") {
    peek(dmaRequestQueue_in, SequencerMsg) {
      enqueue(requestToDir_out, SpandexRequestMsg, request_latency) {
        out_msg.addr := in_msg.LineAddress;
        out_msg.Type := SpandexRequestType:ReqWT;
        out_msg.Requestor := machineID;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.writeMask.setMask(
            addressOffset(in_msg.PhysicalAddress, in_msg.LineAddress),
            in_msg.Len);
        out_msg.Destination.add(mapAddressToMachine(address,
                                                   MachineType:Directory));
        out_msg.MessageSize := MessageSizeType:Writeback_Data;
      }
    }
  }

  action(a_ackCallback, "a", desc="Notify DMA sequencer that write completed") {
    dma_sequencer.ackCallback(address);
  }

  action(d_dataCallback, "d", desc="Forward read data to DMA sequencer") {
    dma_sequencer.dataCallback(tbe.DataBlk, address);
  }

  action(t_updateTBEData, "t", desc="Update TBE data from response") {
    assert(is_valid(tbe));
    peek(dmaResponseQueue_in, SpandexResponseMsg) {
      tbe.DataBlk := in_msg.DataBlk;
    }
  }

  action(v_allocateTBE, "v", desc="Allocate TBE entry") {
    TBEs.allocate(address);
    set_tbe(TBEs[address]);
  }

  action(w_deallocateTBE, "w", desc="Deallocate TBE entry") {
    TBEs.deallocate(address);
    unset_tbe();
  }

  action(p_popRequestQueue, "p", desc="Pop request queue") {
    dmaRequestQueue_in.dequeue(clockEdge());
  }

  action(pr_popResponseQueue, "\p", desc="Pop response queue") {
    dmaResponseQueue_in.dequeue(clockEdge());
  }

  action(zz_stallAndWaitRequestQueue, "zz", desc="Stall request queue") {
    stall_and_wait(dmaRequestQueue_in, address);
  }

  action(wkad_wakeUpAllDependents, "wkad", desc="Wake up stalled requests") {
    wakeUpAllBuffers();
  }

  transition(READY, ReadRequest, BUSY_RD) {
    v_allocateTBE;
    s_sendReadRequest;
    p_popRequestQueue;
  }

  transition(READY, WriteRequest, BUSY_WR) {
    v_allocateTBE;
    sw_sendWriteRequest;
    p_popRequestQueue;
  }

  transition(BUSY_RD, Data, READY) {
    t_updateTBEData;
    d_dataCallback;
    w_deallocateTBE;
    pr_popResponseQueue;
    wkad_wakeUpAllDependents;
  }

  transition(BUSY_WR, Ack, READY) {
    a_ackCallback;
    w_deallocateTBE;
    pr_popResponseQueue;
    wkad_wakeUpAllDependents;
  }

  transition({BUSY_RD, BUSY_WR}, {ReadRequest, WriteRequest}) {
    zz_stallAndWaitRequestQueue;
  }
}