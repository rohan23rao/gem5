protocol "Spandex";
include "MOESI_AMD_Base-msg.sm"; // CPURequestMsg, ResponseMsg, NBProbeRequestMsg,
                                 // UnblockMsg, CoherenceRequestType, ... — all
                                 // actually live here (not in GPU_VIPER-msg.sm)
include "GPU_VIPER-msg.sm";      // VIPERCoalescer external decl (depends on
                                 // MOESI_AMD_Base-msg.sm types)
include "Spandex-msg.sm";        // SpandexRequestMsg, SpandexResponseMsg
include "GPU_VIPER-TCP.sm";     // TCP L1 data cache (unmodified)
include "GPU_VIPER-SQC.sm";     // SQC L1 instruction cache (unmodified)
include "Spandex_TU.sm";        // TU declares MachineType:TU; must come before
                                // GPU_VIPER-TCC.sm because TCC.sm references
                                // MachineType:TU as its NB destination.
include "GPU_VIPER-TCC.sm";     // TCC L2; modified to send to MachineType:TU
                                // instead of MachineType:Directory.
include "Spandex-dir.sm";       // Spandex LLC/Directory
include "Spandex-DMA.sm";       // DMA Controller